#!/usr/bin/env ruby
# frozen_string_literal: true

# Add lib directory to load path
lib = File.expand_path('../lib', __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

# Disable deprecation warnings
Warning[:deprecated] = false
$VERBOSE = nil

# Require bundler setup if using bundle exec
require 'bundler/setup' if defined?(Bundler)
require "logger"

# Patch for active_interaction compatibility with newer ActiveModel
unless defined?(ActiveModel::Errors::CALLBACKS_OPTIONS)
  require 'active_model'

  # Define the missing constant that active_interaction expects
  module ActiveModel
    class Errors
      CALLBACKS_OPTIONS = [:if, :unless, :on, :allow_nil, :allow_blank, :strict].freeze
    end
  end
end

# Load all gems
Bundler.require

# Require the main tools module (which sets up Zeitwerk)
require 'manifold/tools'

# Now require the CLI
require 'manifold/tools/cli'

Signal.trap('INT') do
  warn("\n#{caller.join("\n")}: interrupted")
  exit(1)
end

begin
  Manifold::Tools::Cli.start
rescue Manifold::Tools::Cli::Error => err
  puts "ERROR: #{err.message}"
  exit 1
end
